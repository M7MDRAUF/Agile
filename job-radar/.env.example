# Notification channels - configure at least one.

# ntfy (https://ntfy.sh): install the ntfy app on your phone and subscribe to the topic.
# Pick a long random topic name: anyone who knows it can read your notifications.
NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh
# NTFY_TOKEN=

# Telegram: create a bot with @BotFather, send it a message, then read your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
