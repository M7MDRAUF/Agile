{
  "name": "job-radar",
  "version": "1.0.0",
  "private": true,
  "description": "Hourly-scheduled junior / new-grad SWE & full-stack job watcher with push notifications",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "once": "tsx src/cli.ts run",
    "dry-run": "tsx src/cli.ts run --dry-run",
    "watch": "tsx src/cli.ts watch",
    "test-notify": "tsx src/cli.ts test-notify",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "tsx": "^4.22.3"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
